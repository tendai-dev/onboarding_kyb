# NextAuth Configuration (REQUIRED)
# CRITICAL: Generate a secure random secret: openssl rand -base64 32
NEXTAUTH_URL=https://partner-mukuru.kurasika.tech
NEXTAUTH_SECRET=your-secret-key-here-generate-a-random-string

# Keycloak Configuration (REQUIRED)
KEYCLOAK_CLIENT_ID=kyb-connect-portal
# KEYCLOAK_CLIENT_SECRET is OPTIONAL - only needed for confidential clients
# The kyb-connect-portal client is configured as a public client (uses PKCE)
# Leave this empty or omit it for public clients
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=https://keycloak-staging.app-stg.mukuru.io/realms/mukuru
KEYCLOAK_WELL_KNOWN=https://keycloak-staging.app-stg.mukuru.io/realms/mukuru/.well-known/openid-configuration
# KEYCLOAK_REDIRECT_URI is OPTIONAL - defaults to {NEXTAUTH_URL}/api/auth/callback/keycloak
# Only set this if Keycloak is configured to redirect to a different URL (e.g., /auth/callback)
# KEYCLOAK_REDIRECT_URI=https://partner-mukuru.kurasika.tech/auth/callback

# Redis Configuration (REQUIRED for token storage)
REDIS_URL=redis://localhost:6379

# Entity Configuration Service API
NEXT_PUBLIC_ENTITY_CONFIG_API_BASE_URL=http://localhost:8092
NEXT_PUBLIC_CHECKLIST_API_BASE_URL=http://localhost:8093
NEXT_PUBLIC_WORK_QUEUE_API_BASE_URL=http://localhost:8094
NEXT_PUBLIC_ONBOARDING_API_BASE_URL=http://localhost:8095

# Backend API URL (CRITICAL for production)
# For production, set this to your actual backend/gateway URL
# Examples:
#   - If using a gateway: https://gateway.yourdomain.com
#   - If direct backend: https://api.yourdomain.com:8001
#   - If Docker service: http://onboarding-api:8001 (internal Docker network)
# Defaults to http://localhost:8001 if not set (DEVELOPMENT ONLY)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Gateway URL (alternative to NEXT_PUBLIC_BACKEND_URL)
# Use this if you have a gateway/proxy in front of your backend services
# NEXT_PUBLIC_GATEWAY_URL=https://gateway.yourdomain.com

# Sentry Error Monitoring Configuration
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
# Set to "true" to enable Sentry in development
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false

# SendGrid Email Configuration (NOT NEEDED - Backend handles all email sending)
# All email sending goes through the backend API which has SendGrid configured.
# The backend is the single source of truth for email configuration.
# These variables are kept for backward compatibility only and are not used.
# SENDGRID_API_KEY=not-needed-backend-handles-this
# SENDGRID_FROM_EMAIL=not-needed-backend-handles-this
# SENDGRID_FROM_NAME=not-needed-backend-handles-this

# Application URL (for email links)
NEXT_PUBLIC_APP_URL=https://partner-mukuru.kurasika.tech
