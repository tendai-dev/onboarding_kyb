# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-key-here

# Azure AD (Entra AD) Configuration
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=your-tenant-id
NEXT_PUBLIC_AZURE_AD_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# Backend API Configuration
# IMPORTANT: Gateway runs on port 8000, not default port 80
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_PROJECTIONS_API_BASE_URL=http://localhost:8090
NEXT_PUBLIC_MESSAGING_API_BASE_URL=http://localhost:8087
NEXT_PUBLIC_AUDIT_LOG_API_BASE_URL=http://localhost:8011
NEXT_PUBLIC_RISK_API_BASE_URL=http://localhost:8006
NEXT_PUBLIC_ENTITY_CONFIG_API_BASE_URL=http://localhost:8003

# Sentry Error Monitoring Configuration
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
# Set to "true" to enable Sentry in development
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false

# Redis Configuration
REDIS_URL=redis://localhost:6379

# SignNow API Configuration
# Option 1: Use Basic Auth Token (recommended - base64 encoded clientId:secretKey)
# This is the Basic Authorization Token from SignNow API Dashboard
# SECURITY: Replace with your actual token from SignNow API Dashboard
SIGNNOW_BASIC_AUTH_TOKEN=your-base64-encoded-token-here

# Option 2: Use Client ID and Secret (alternative method)
# If you prefer to use Client ID and Secret separately instead of Basic Auth Token
# SECURITY: Replace with your actual credentials from SignNow API Dashboard
# SIGNNOW_CLIENT_ID=your-client-id-here
# SIGNNOW_CLIENT_SECRET=your-client-secret-here

# SignNow Account Credentials (required for OAuth token generation)
# These are your SignNow account login credentials
# Use the email address you used to sign up for SignNow (can be Google email/Gmail)
SIGNNOW_USERNAME=your-google-email@gmail.com
SIGNNOW_PASSWORD=your-signnow-password

# SendGrid Email Configuration (NOT NEEDED - Backend handles all email sending)
# All email sending goes through the backend API which has SendGrid configured.
# The backend is the single source of truth for email configuration.
# These variables are kept for backward compatibility only and are not used.
# SENDGRID_API_KEY=not-needed-backend-handles-this
# SENDGRID_FROM_EMAIL=not-needed-backend-handles-this
# SENDGRID_FROM_NAME=not-needed-backend-handles-this

# Application URL (for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3001
