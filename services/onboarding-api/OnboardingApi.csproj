<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src/Domain/OnboardingApi.Domain.csproj" />
    <ProjectReference Include="src/Application/OnboardingApi.Application.csproj" />
    <ProjectReference Include="src/Infrastructure/OnboardingApi.Infrastructure.csproj" />
    <ProjectReference Include="src/Presentation/OnboardingApi.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude all source files - this project only references other projects -->
    <Compile Remove="**/*.cs" />
    <Compile Include="src/Presentation/Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.2.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.5" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
