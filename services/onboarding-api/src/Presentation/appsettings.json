{
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres;Database=kyb_case;Username=kyb;Password=kyb_password",
    "Redis": "redis:6379"
  },
  "Outbox": {
    "PollIntervalMs": 300,
    "MaxRetries": 3
  },
  "EntityConfig": {
    "BaseUrl": "http://localhost:8003"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/mukuru",
    "Audience": "kyb-case-api",
    "RequireHttpsMetadata": false
  },
  "Services": {
    "EntityConfiguration": {
      "BaseUrl": "http://localhost:8003"
    },
    "WorkQueue": {
      "BaseUrl": "http://localhost:8005"
    },
    "Risk": {
      "BaseUrl": "http://localhost:8006"
    },
    "Projections": {
      "BaseUrl": "http://localhost:8007"
    },
    "Document": {
      "BaseUrl": "http://localhost:8008"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "kyb-case-api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true
}